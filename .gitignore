# JavaScript / Node
node_modules/
npm-debug.log
yarn-error.log
.yarn/

# Metro bundler cache
.metro-health-check*

# React Native generated
*.jsbundle
/ios/build/
/ios/.xcode.env.local

# CocoaPods (keep Podfile.lock for reproducible builds)
/ios/Pods/
/ios/*.xcworkspace/

# Android build outputs
/android/build/
/android/app/build/
/android/.gradle/
/android/captures/
/android/local.properties

# Android signing keys — NEVER commit real keystores
# debug.keystore is safe to exclude (regenerated by keytool)
/android/app/debug.keystore
/android/app/release.keystore
*.jks
*.keystore

# Gradle wrapper JAR (binary, regenerated by `gradle wrapper`)
/android/gradle/wrapper/gradle-wrapper.jar

# macOS
.DS_Store
**/.DS_Store

# Editor / IDE
.idea/
*.iml
.vscode/
*.swp
*.swo

# Environment
.env
.env.local
.env.*

# Test coverage
/coverage/
